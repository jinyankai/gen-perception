# Copy values into the shell environment; do not commit a real .env file.
# Use an approved high-capacity path, not the nearly full system filesystem.
MODEL_CACHE=/data/USER/gen-perception/model_cache
DATA_ROOT=/data/USER/gen-perception/data
OUTPUT_ROOT=/data/USER/gen-perception/outputs

# China-accessible community mirror. Override per process if required.
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/data/USER/gen-perception/model_cache/huggingface
HF_HUB_CACHE=/data/USER/gen-perception/model_cache/huggingface/hub
HF_HUB_DISABLE_TELEMETRY=1

# Never write HF_TOKEN into a tracked file. Export it only in the shell when a
# gated repository has already been accepted on the official Hugging Face site.
